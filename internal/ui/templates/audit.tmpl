{{define "content"}}{{with .Data}}
<div class="flex flex-wrap items-end justify-between gap-2">
  <h1 class="text-xl font-semibold text-slate-900 dark:text-white">Audit log</h1>
  <p class="muted">Retention {{.Retention}} · responses {{.Responses}}</p>
</div>
<section class="card p-0 sm:p-0">
  {{if not .Entries}}
  <p class="muted p-5">No tool calls recorded yet.</p>
  {{else}}
  <div class="overflow-x-auto">
    <table class="w-full text-left text-sm">
      <thead class="text-xs uppercase tracking-wide text-slate-500 dark:text-slate-400">
        <tr class="border-b border-slate-200 dark:border-slate-700">
          <th scope="col" class="px-4 py-3 font-medium">Time (UTC)</th>
          <th scope="col" class="px-4 py-3 font-medium">Key</th>
          <th scope="col" class="px-4 py-3 font-medium">Tool</th>
          <th scope="col" class="px-4 py-3 font-medium">Arguments</th>
          <th scope="col" class="px-4 py-3 font-medium">Response</th>
        </tr>
      </thead>
      <tbody class="divide-y divide-slate-200 dark:divide-slate-700">
        {{range .Entries}}
        <tr class="align-top" data-testid="audit-row">
          <td class="px-4 py-3 whitespace-nowrap">{{.CreatedAt.Format "2006-01-02 15:04:05"}}</td>
          <td class="px-4 py-3">{{.KeyLabel}}</td>
          <td class="px-4 py-3"><span class="badge-accent">{{.ToolName}}</span></td>
          <td class="px-4 py-3"><code class="mono">{{.Arguments}}</code></td>
          <td class="px-4 py-3">{{with .Response}}<code class="mono">{{.}}</code>{{else}}<span class="muted">—</span>{{end}}</td>
        </tr>
        {{end}}
      </tbody>
    </table>
  </div>
  {{end}}
</section>
{{end}}{{end}}
