{{define "layout"}}<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="color-scheme" content="light dark">
<title>{{.Title}} · mcp-auth-proxy</title>
<link rel="stylesheet" href="{{asset "app.css"}}">
<script src="{{asset "app.js"}}"></script>
</head>
<body>
<header class="border-b border-slate-200/80 bg-white/70 backdrop-blur dark:border-slate-700/60 dark:bg-slate-900/60">
  <div class="mx-auto flex max-w-4xl flex-wrap items-center gap-x-4 gap-y-3 px-4 py-3">
    <a href="/" class="flex items-center gap-2 font-semibold text-slate-900 no-underline hover:no-underline dark:text-white">
      <span class="grid size-8 place-items-center rounded-xl bg-teal-700 text-white dark:bg-teal-400 dark:text-slate-950" aria-hidden="true">
        <svg viewBox="0 0 24 24" class="size-4" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="4" y="11" width="16" height="10" rx="2"/><path d="M8 11V7a4 4 0 0 1 8 0v4"/></svg>
      </span>
      mcp-auth-proxy
    </a>
    {{$section := .Section}}
    {{with .User}}
    <nav class="order-last flex w-full gap-1 overflow-x-auto rounded-full bg-slate-100 p-1 sm:order-none sm:w-auto dark:bg-slate-800" aria-label="Main">
      {{range navItems .Admin}}
      <a href="{{.Href}}"{{if eq .Section $section}} aria-current="page"{{end}}
        class="shrink-0 rounded-full px-3.5 py-1.5 text-sm font-medium whitespace-nowrap text-slate-600 no-underline transition-colors hover:bg-white/60 hover:text-slate-900 hover:no-underline motion-reduce:transition-none aria-[current=page]:bg-white aria-[current=page]:text-teal-800 aria-[current=page]:shadow-sm dark:text-slate-300 dark:hover:bg-slate-700/60 dark:hover:text-white dark:aria-[current=page]:bg-slate-700 dark:aria-[current=page]:text-teal-200">{{.Label}}</a>
      {{end}}
    </nav>
    {{end}}
    <div class="ml-auto flex items-center gap-2">
      <div class="flex rounded-full border border-slate-300 p-0.5 dark:border-slate-600" role="group" aria-label="Color theme">
        {{range $mode := themes}}
        <button type="button" data-theme-set="{{$mode}}" aria-pressed="false" title="{{$mode}} theme"
          class="cursor-pointer rounded-full px-2.5 py-1 text-xs font-medium text-slate-600 aria-pressed:bg-teal-700 aria-pressed:text-white dark:text-slate-300 dark:aria-pressed:bg-teal-400 dark:aria-pressed:text-slate-950">{{$mode}}</button>
        {{end}}
      </div>
      {{with .User}}
      <span class="flex items-center gap-2 text-sm" title="Logged in as {{.Name}}">
        <span class="grid size-7 place-items-center rounded-full bg-teal-100 text-xs font-semibold text-teal-800 uppercase dark:bg-teal-400/15 dark:text-teal-200" aria-hidden="true">{{initial .Name}}</span>
        <strong class="hidden text-slate-800 sm:inline dark:text-slate-100" data-testid="username">{{.Name}}</strong>
      </span>
      <form method="post" action="/logout"><button class="btn-ghost">Log out</button></form>
      {{end}}
    </div>
  </div>
</header>
<main class="mx-auto max-w-4xl space-y-6 px-4 py-8">
{{template "content" .}}
</main>
</body>
</html>
{{end}}
