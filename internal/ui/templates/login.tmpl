{{define "content"}}{{with .Data}}
<div class="mx-auto max-w-sm pt-6">
  <div class="card">
    <h1 class="mb-1 text-xl font-semibold text-slate-900 dark:text-white">Welcome back</h1>
    <p class="muted mb-5">Log in to manage your MCP keys.</p>
    <form method="post" action="/login" class="space-y-4">
      <input type="hidden" name="next" value="{{.Next}}">
      <div>
        <label class="field-label" for="username">Username</label>
        <input class="field" id="username" type="text" name="username" required autocomplete="username">
      </div>
      <div>
        <label class="field-label" for="password">Password</label>
        <input class="field" id="password" type="password" name="password" required autocomplete="current-password">
      </div>
      {{with .Error}}<p class="alert-error" role="alert">{{.}}</p>{{end}}
      <button type="submit" class="btn w-full">Log in</button>
    </form>
  </div>
</div>
{{if .Invites}}
<section class="card mx-auto max-w-2xl" aria-labelledby="invites">
  <h2 id="invites" class="card-title">Pending invites</h2>
  <p class="muted mb-4">Users who have not set a password yet. The link logs them in and lets them choose one.</p>
  <ul class="space-y-3">
    {{range .Invites}}
    <li class="flex flex-wrap items-center gap-2">
      <strong>{{.Username}}</strong>
      <a href="{{.Link}}">set password</a>
      <code class="mono min-w-0 flex-1">{{.Link}}</code>
      <button type="button" class="btn-ghost" data-copy="{{.Link}}">Copy</button>
    </li>
    {{end}}
  </ul>
</section>
{{end}}
{{end}}{{end}}
